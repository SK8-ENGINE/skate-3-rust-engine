
# Keep bundled package bytes reproducible across checkouts.
sdk/examples/** text eol=lf
sdk/examples/**/*.glb binary
mods/*.zip binary
sdk/examples/**/*.wav binary
# Shell tools run in Git Bash, which needs LF line endings.
tools/**/*.sh text eol=lf
# Every OS: shell scripts need LF (Linux, macOS, Git Bash), batch files CRLF (cmd).
*.sh text eol=lf
*.bat text eol=crlf
